# RoboVerse API Environment Configuration
NODE_ENV=development
PORT=4000
CLIENT_WEB_URL=http://localhost:3000
CLIENT_MOBILE_URL=http://localhost:8081

# PostgreSQL Database (Prisma + Supabase)
# On IPv4-only networks, use Supabase's session/transaction pooler URL rather
# than db.<project-ref>.supabase.co, which is a direct IPv6 connection.
DATABASE_URL=postgresql://roboverse:roboverse_pass@localhost:5432/roboverse_db?schema=public

# Redis Connection (Defaults to fast in-memory store if not available)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=generate-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=generate-a-different-unique-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Inference (Rituu - Anthropic Claude API with Vision)
# Server-side only: Key never exposed to client
ANTHROPIC_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=

# Corporate & Tax (GST 18%) Details
ROBOVERSE_GSTIN=
ROBOVERSE_COMPANY_NAME=
ROBOVERSE_COMPANY_ADDRESS=
ROBOVERSE_HSN_CODE=999293
