NODE_ENV=development
PORT=3000

# Client URLs
NEXT_PUBLIC_SITE_URL=https://roboverse-delta.vercel.app
CLIENT_WEB_URL=http://localhost:3000
CLIENT_MOBILE_URL=http://localhost:8081

# Supabase Production Project (Project ID: aqxtykwncclxymzxvgif)
