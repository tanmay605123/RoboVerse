# ==========================================
# RoboVerse Monorepo Environment Configuration
# Set these values from the Supabase project you own and intend to use.
# ==========================================
NODE_ENV=development
PORT=3000

# Client URLs
NEXT_PUBLIC_SITE_URL=https://roboverse-delta.vercel.app
CLIENT_WEB_URL=http://localhost:3001
CLIENT_MOBILE_URL=http://localhost:8081
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
API_BACKEND_URL=http://localhost:4000/api/v1
# Optional direct API URL for the web client; leave blank to use Next.js proxy.
NEXT_PUBLIC_API_URL=

# Supabase project URL and publishable key (safe for browser use with RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for Edge Functions and privileged server operations. Never use NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase PostgreSQL connection string (server-only; use the Supavisor pooler for serverless deployments)
DATABASE_URL=

# Razorpay Subscriptions & Dynamic UPI QR Codes
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini API for Rituu Robotics AI (Server-Side Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Maps Platform (Maker Radar Places New, Geocoding)
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_PLACES_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Business & 18% GST Configuration (India)
ROBOVERSE_GSTIN=
ROBOVERSE_COMPANY_NAME=
ROBOVERSE_COMPANY_ADDRESS=
